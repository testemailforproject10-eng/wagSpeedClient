# ── Supabase ─────────────────────────────────────────────────────────────────
# Project URL — safe to expose (used in browser and server code)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Anon key — safe to expose (RLS controls what it can access)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Service role key — NEVER expose publicly (bypasses RLS entirely)
# Required for server-side writes in the API routes.
# Get it from: Supabase Dashboard → Project Settings → API → service_role
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
